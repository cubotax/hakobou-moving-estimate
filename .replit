modules = ["nodejs-20", "web"]

[nix]
channel = "stable-25_05"

run = "cd line-backend && node server.js"

[[ports]]
localPort = 3000
externalPort = 80

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "Run"
mode = "sequential"
author = 43002648

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd line-backend && PORT=3000 node server.js"
